# Create an EmailJS service and one email template, then add these values.
# Set this to the canonical public website origin for metadata and sitemap URLs.
NEXT_PUBLIC_SITE_URL=https://www.planex-jp.com
# Set the EmailJS template To Email field to {{to_email}} and BCC field to
# {{bcc_emails}}. The first configured address is the visible To recipient;
# remaining addresses are blind copies. Separate addresses with commas; this
# same list receives both contact enquiries and job applications.
# The template should also include form_kind, locale, and the form field variables.
EMAILJS_SERVICE_ID=service_example123
EMAILJS_TEMPLATE_ID=template_admin_notification_example
EMAILJS_AUTOREPLY_TEMPLATE_ID=template_japanese_thank_you_example
EMAILJS_PUBLIC_KEY=replace_with_your_emailjs_public_key
EMAILJS_RECIPIENTS=contact@example.com,hr@example.com
# Optional. Keep this private key server-side if enabled in your EmailJS account.
EMAILJS_PRIVATE_KEY=
